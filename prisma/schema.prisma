datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Recipe {
  id            Int     @id @default(autoincrement())
  title         String @unique
  image         String?
  ingredients   String
  instructions  String
  prepTime      Int?
  cookTime      Int?
  favoriteCount Int     @default(0)
}





